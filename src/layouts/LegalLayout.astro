---
import BaseLayout from './BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { DEFAULT_WHATSAPP_MESSAGE } from '../lib/contact';

const { title, description, pageTitle, updated } = Astro.props;
---

<BaseLayout title={title} description={description} whatsappMessage={DEFAULT_WHATSAPP_MESSAGE}>
  <div class="legal-page">
    <SiteHeader nav="marketing" whatsappMessage={DEFAULT_WHATSAPP_MESSAGE} menuLabel="LEGAL" />
    <main>
      <section class="legal-hero section-dark"><div class="container"><p class="eyebrow eyebrow--light">Legal</p><h1>{pageTitle}</h1></div></section>
      <section class="section legal-body"><div class="container legal-body__inner">
        <nav class="legal-nav" aria-label="On this page"><span class="legal-nav__label">On this page</span><slot name="nav" /></nav>
        <div class="legal-prose"><slot /></div>
      </div></section>
    </main>
    <SiteFooter whatsappMessage={DEFAULT_WHATSAPP_MESSAGE} />
  </div>
</BaseLayout>
