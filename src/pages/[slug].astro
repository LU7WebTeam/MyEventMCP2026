---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';

const imageBase = 'https://myeventmcp.com/wp-content/uploads';
const addOns = [
  ['Audio Equipments', '2 hall speakers, monitors, subwoofers, mixer, wireless mics and audio crew', 'RM3,000'],
  ['Event Laptop', 'Capture card, presentation slides and operator', 'RM500'],
  ['Additional MCP Camera', 'Canon XF605, operator and cables', 'RM800'],
  ['Wireless Visual Transmitter', 'Transmitter, receiver and cable', 'RM850'],
  ['Lighting Package', '1x Tiger Touch lighting mixer, 4 Sharpy and 6 face lights', 'RM5,000'],
  ['Livestreaming', 'Vmix software, laptop and YouTube / Facebook setup', 'RM2,500'],
  ['Event Highlights', 'Videographer and video editing', 'RM3,500'],
  ['Zoom Webinar', 'Operator, laptop and Zoom Webinar for up to 499 pax', 'RM2,000'],
  ['Event Photography', 'Up to 100 edited photos and photographer', 'RM2,500'],
  ['Internet Connection', 'Up to 100 Mbps high-speed connection, location dependent', 'RM1,500'],
];

const packages = {
  'silver-mcp-package': {
    name: 'Silver MCP', title: 'Silver MCP Package', eyebrow: 'Essential multi-camera production', tone: 'silver', price: 'RM1,800', lead: '1 static Canon XF605 camera, ATEM mini pro switcher, 2 crew members and full event recording for 1–8 hours.', description: 'A focused, single-angle setup for events with one clear focal point.', setup: '1 static camera / 2 crews', inclusions: [['Switcher', 'ATEM mini pro — 4 HDMI inputs, 1 HDMI output, 1 audio input'], ['Camera', '1 Canon XF605 static camera on a tripod'], ['Crew', '2 experienced crew members'], ['Monitor and cabling', '1 monitor and production cablings'], ['Event coverage', '1 day / 1–8 hours'], ['Rehearsal and setup', 'Same day as the event / 1–8 hours'], ['Recording', 'Full event video in soft copy']],
  },
  'gold-mcp-package': {
    name: 'Gold MCP', title: 'Gold MCP Package', eyebrow: 'Enhanced multi-camera production', tone: 'red', price: 'RM2,800', lead: '2 static Canon XF605 cameras, ATEM Extreme switcher, 3 crew members and full event recording for 1–8 hours.', description: 'A two-camera setup for a more dynamic view, keeping the stage and audience in the story.', setup: '2 static cameras / 3 crews', inclusions: [['Switcher', 'ATEM Extreme — 8 HDMI inputs, 2 HDMI outputs, 1 audio input'], ['Cameras', '2 Canon XF605 static cameras on tripods'], ['Crew', '3 experienced crew members'], ['Monitor', '1 production monitor'], ['Event coverage', '1 day / 1–8 hours'], ['Rehearsal and setup', 'Same day as the event / 1–8 hours'], ['Recording and cabling', 'Full event video in soft copy and cablings']],
  },
  'diamond-mcp-package': {
    name: 'Diamond MCP', title: 'Diamond MCP Package', eyebrow: 'Premium multi-camera production', tone: 'navy', price: 'RM5,500', lead: '3 static Canon XF605 cameras, ATEM Television Studio 4K8, 4 crew members and full event recording for 1–8 hours.', description: 'Full multi-angle coverage for larger productions, with wide shots, close-ups and alternative perspectives.', setup: '3 static cameras / 4 crews', inclusions: [['Switcher', 'ATEM Television Studio 4K8 — 8 SDI inputs, 8 SDI outputs, 1 audio input'], ['Cameras', '3 Canon XF605 static cameras on tripods'], ['Crew', '4 experienced crew members'], ['Monitor', '1 production monitor'], ['Event coverage', '1 day / 1–8 hours'], ['Rehearsal and setup', 'Set up and 3-hour rehearsal a day prior'], ['Recording and cabling', 'Full event video in soft copy and cablings']],
  },
  'ptz-robocam-setup': {
    name: 'PTZ RoboCam', title: 'PTZ RoboCam Setup', eyebrow: 'Advanced remote-controlled coverage', tone: 'gold', price: 'RM4,500', lead: '3 PTZ cameras, joystick controller, 3 crew members, laptop and monitors for flexible remote-controlled coverage.', description: 'Pan, tilt and zoom from a single position while the production team follows speakers and activity in real time.', setup: '3 PTZ cameras / 3 crews', inclusions: [['Switcher', 'ATEM Extreme — 8 HDMI inputs, 2 HDMI outputs, 1 audio input'], ['Cameras', '3 PTZ cameras on tripods'], ['Controller', '1 PTZ joystick controller'], ['Crew', '3 experienced crew members'], ['Monitors', '1 laptop and 2 monitors'], ['Event coverage', '1 day / 1–8 hours'], ['Rehearsal and recording', 'Same-day setup, rehearsal and full event recording in soft copy']],
  },
  'customised-solution': {
    name: 'Customised Solution', title: 'Customised Solution', eyebrow: 'Tailored event coverage', tone: 'light', price: 'Custom', lead: 'Build a production setup around your venue, audience, event format and technical requirements.', description: 'Choose only what your event needs, then add extras from the full service catalogue.', setup: 'Mix and match / custom quote', custom: true, inclusions: [['Step 01', 'Mix and match our core packages'], ['Step 02', 'Select only the products and services you need'], ['Step 03', 'Add extras from the additional services list'], ['Pricing', 'Final quote confirmed after an event brief']],
  },
};

export function getStaticPaths() {
  return ['gold-mcp-package', 'diamond-mcp-package', 'ptz-robocam-setup', 'customised-solution'].map((slug) => ({ params: { slug } }));
}

const pkg = packages[Astro.params.slug];
const galleryByPackage = {
  'gold-mcp-package': [
    ['gold-mcp-package-event-production-setup.webp', 'Gold MCP package event production setup with multiple cameras.'],
    ['gold-mcp-package-camera-operator.webp', 'Gold MCP package camera operator monitoring the live production feed.'],
    ['gold-mcp-package-live-event-camera.webp', 'Gold MCP package camera setup filming a live event.'],
    ['gold-mcp-package-production-crew.webp', 'Gold MCP package production crew managing event video equipment.'],
    ['gold-mcp-package-professional-camera-setup.webp', 'Professional camera setup used for Gold MCP package event coverage.'],
    ['gold-mcp-package-event-production-equipment.webp', 'Gold MCP package event production equipment ready for operation.'],
    ['gold-mcp-package-multi-camera-production.webp', 'Gold MCP package multi-camera production control equipment.'],
    ['gold-mcp-package-live-production-setup.webp', 'Gold MCP package live production setup for event coverage.'],
  ],
  'diamond-mcp-package': [
    ['diamond-mcp-package-event-production-setup.webp', 'Diamond MCP package event production setup with multiple cameras.'],
    ['diamond-mcp-package-camera-operator.webp', 'Diamond MCP package camera operator monitoring the live production feed.'],
    ['diamond-mcp-package-live-event-camera.webp', 'Diamond MCP package camera setup filming a live event.'],
    ['diamond-mcp-package-production-crew.webp', 'Diamond MCP package production crew managing event video equipment.'],
    ['diamond-mcp-package-professional-camera-setup.webp', 'Professional camera setup used for Diamond MCP package event coverage.'],
    ['diamond-mcp-package-event-production-equipment.webp', 'Diamond MCP package event production equipment ready for operation.'],
    ['diamond-mcp-package-multi-camera-production.webp', 'Diamond MCP package multi-camera production control equipment.'],
    ['diamond-mcp-package-live-production-setup.webp', 'Diamond MCP package live production setup for event coverage.'],
  ],
  'ptz-robocam-setup': [
    ['ptz-robocam-setup-remote-camera.webp', 'PTZ RoboCam setup with a remote-controlled event camera.'],
    ['ptz-robocam-setup-production-view.webp', 'PTZ RoboCam production view during live event coverage.'],
    ['ptz-robocam-setup-ptz-camera.webp', 'PTZ RoboCam camera ready for remote pan, tilt and zoom control.'],
    ['ptz-robocam-setup-camera-control.webp', 'PTZ RoboCam camera control equipment for live event production.'],
    ['ptz-robocam-setup-event-camera.webp', 'PTZ RoboCam event camera positioned for flexible coverage.'],
    ['ptz-robocam-setup-production-equipment.webp', 'PTZ RoboCam production equipment prepared for an event.'],
    ['ptz-robocam-setup-live-event-coverage.webp', 'PTZ RoboCam setup providing live event coverage.'],
    ['ptz-robocam-setup-remote-production.webp', 'PTZ RoboCam remote production setup with professional equipment.'],
  ],
};
const gallery = (galleryByPackage[Astro.params.slug] || []).map(([file, alt]) => ({ src: `/` + (Astro.params.slug === 'ptz-robocam-setup' ? 'ptz-gallery' : Astro.params.slug === 'gold-mcp-package' ? 'gold-gallery' : 'diamond-gallery') + `/${file}`, alt }));
const related = Object.entries(packages).filter(([slug]) => slug !== Astro.params.slug);
---

<BaseLayout title={`${pkg.title} | MyEventMCP`} description={`${pkg.title} for event coverage across Malaysia.`} image={`${imageBase}/2025/01/DSC02241-scaled.jpg`}>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Service', serviceType: pkg.title, name: pkg.name, description: pkg.description, url: `https://myeventmcp.com/${Astro.params.slug}/`, provider: { '@type': 'Organization', name: 'MyEventMCP', url: 'https://myeventmcp.com/' }, areaServed: 'Malaysia' })} />
  <div class="package-page">
    <header class="site-header" data-header><div class="header-inner"><a class="brand" href="/" aria-label="MyEventMCP home"><img src="/logo-color.webp" alt="MyEventMCP" /></a><nav class="desktop-nav" aria-label="Primary navigation"><a href="/#about">About</a><a href="/#packages">Packages</a><a href="/#portfolio">Portfolio</a><a href="/#faq">FAQ</a></nav><div class="header-right"><a class="button button--small header-cta" href="/#quote">Get a quote <span aria-hidden="true">↗</span></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle><span></span><span></span><span class="sr-only">Open navigation</span></button></div></div></header>
    <div class="mobile-menu" id="mobile-menu" data-mobile-menu><div class="mobile-menu__top"><span class="mono-label">PACKAGE</span><button class="menu-close" type="button" data-menu-close aria-label="Close navigation">×</button></div><nav aria-label="Mobile navigation"><a href="/#about">About</a><a href="/#packages">Packages</a><a href="/#portfolio">Portfolio</a><a href="/#faq">FAQ</a><a class="button" href="/#quote">Get a quote <span aria-hidden="true">↗</span></a></nav></div>
    <main>
      <section class="package-hero section-dark"><div class="package-hero__image"><img src={`${imageBase}/2025/01/DSC02241-scaled.jpg`} alt="Event production team monitoring a live multi-camera feed." /></div><div class="package-hero__wash"></div><div class="container package-hero__inner"><div class="package-hero__copy"><a class="back-link" href="/#packages">← All packages</a><p class="eyebrow eyebrow--light">{pkg.eyebrow}</p><h1>{pkg.name}<br /><em>Package.</em></h1><p class="package-hero__lead">{pkg.lead}</p><div class="package-hero__actions"><a class="button button--primary" href="/#quote">Enquire now <span aria-hidden="true">↗</span></a><a class="text-link text-link--light" href="#at-a-glance">View specs <span aria-hidden="true">↓</span></a></div><div class="package-quickfacts"><span>{pkg.setup.split(' / ')[0]}</span><span>{pkg.setup.split(' / ')[1]}</span><span>{pkg.custom ? 'Custom quote' : '1–8 hours'}</span><span>{pkg.custom ? 'Built around your brief' : 'Full event recording'}</span></div></div><aside class="package-price"><span class="mono-label">Starting from</span><strong>{pkg.price}</strong>{!pkg.custom && <span>/ day</span>}<p>{pkg.custom ? 'Final pricing is tailored to your requirements.' : 'Final pricing depends on your event requirements, date and location.'}</p></aside></div></section>
      <section class="package-intro section" id="at-a-glance"><div class="container package-intro__grid"><div><p class="eyebrow">Package at a glance</p><h2>{pkg.custom ? <>A setup built<br /><em>around you.</em></> : <>Simple setup.<br /><em>Clear coverage.</em></>}</h2><div class="package-scenarios"><span class="mono-label">Best for</span><div><span>Corporate gatherings</span><span>Conferences</span><span>Seminars</span><span>Launches</span></div></div></div><div class="package-specs">{pkg.inclusions.map((item) => <div><span>{item[0]}</span><strong>{item[1]}</strong></div>)}</div></div></section>
      <section class="section addons-section"><div class="container package-intro__grid"><div><p class="eyebrow eyebrow--light">Optional add-ons</p><h2>Build the setup<br /><em>around your event.</em></h2></div><div class="addon-table">{addOns.map((addon) => <article class="addon-line"><div><h3>{addon[0]}</h3><p>{addon[1]}</p></div><strong>from {addon[2]}<small>/day</small></strong></article>)}</div></div></section>
       {gallery.length > 0 && <section class="section package-gallery" aria-labelledby="package-gallery-title"><div class="container package-gallery__head"><div><p class="eyebrow">The craft in motion</p><h2 id="package-gallery-title">Small setup.<br /><em>Big attention.</em></h2></div><p class="muted">Our crew handles the details behind the scenes so your audience can stay with the story. Open any image to view the full gallery.</p></div><div class="container package-gallery__grid">{gallery.map((item, index) => <button class={`package-gallery__item package-gallery__item--${index}`} type="button" data-lightbox-type="image" data-lightbox-group="package-gallery" data-lightbox-src={item.src} data-lightbox-alt={item.alt} data-lightbox-caption={item.alt} aria-label={`Open image ${index + 1} of ${gallery.length}`}><img src={item.src} alt={item.alt} loading="lazy" /><span>View image <b aria-hidden="true">↗</b></span></button>)}</div></section>}
      <section class="package-cta section-dark"><div class="container package-cta__inner"><div><p class="eyebrow eyebrow--light">Ready when you are</p><h2>Let's frame your<br /><em>event right.</em></h2></div><div><p>Tell us about your event, venue and date. We will recommend the right setup and confirm your final quote.</p><a class="button button--primary" href="/#quote">Request a quote <span aria-hidden="true">↗</span></a></div></div></section>
      <section class="section related-section"><div class="container"><div class="related-heading"><p class="eyebrow">Need more angles?</p><h2>Explore related<br /><em>packages.</em></h2></div><div class="related-grid">{related.map(([slug, item]) => <article class={`package-card package-card--${item.tone}`}><div class="package-card__top"><p class="eyebrow">{item.eyebrow}</p><span class="package-card__dot"></span></div><h3>{item.name}</h3><p class="package-card__description">{item.description}</p><span class="package-card__setup">{item.setup}</span><div class="package-card__bottom"><div><span class="mono-label">From</span><strong>{item.price}{item.price !== 'Custom' && <small>/day</small>}</strong></div><a class="circle-arrow" href={`/${slug}/`} aria-label={`View ${item.name}`}>↗</a></div></article>)}</div></div></section>
    </main>
     <SiteFooter />
     <div class="lightbox" data-lightbox aria-hidden="true"><button type="button" class="lightbox__close" data-lightbox-close aria-label="Close image gallery">×</button><button type="button" class="lightbox__nav lightbox__prev" data-lightbox-prev aria-label="Previous image">‹</button><button type="button" class="lightbox__nav lightbox__next" data-lightbox-next aria-label="Next image">›</button><div class="lightbox__stage"><img data-lightbox-media-image alt="" /></div><p class="lightbox__caption" data-lightbox-caption></p><span class="lightbox__counter" data-lightbox-counter></span></div>
  </div>
</BaseLayout>

<script>
  const header = document.querySelector('[data-header]');
  const menu = document.querySelector('[data-mobile-menu]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const close = document.querySelector('[data-menu-close]');
  const setMenu = (open) => { menu?.classList.toggle('is-open', open); toggle?.setAttribute('aria-expanded', String(open)); document.body.classList.toggle('menu-open', open); };
  toggle?.addEventListener('click', () => setMenu(true)); close?.addEventListener('click', () => setMenu(false)); menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  window.addEventListener('scroll', () => header?.classList.toggle('is-scrolled', window.scrollY > 20), { passive: true });

  const lightbox = document.querySelector('[data-lightbox]');
  const lightboxImage = lightbox?.querySelector('[data-lightbox-media-image]');
  const lightboxCaption = lightbox?.querySelector('[data-lightbox-caption]');
  const lightboxCounter = lightbox?.querySelector('[data-lightbox-counter]');
  const items = [...document.querySelectorAll('[data-lightbox-type]')].map((el, index) => ({ el, index, src: el.getAttribute('data-lightbox-src') || '', alt: el.getAttribute('data-lightbox-alt') || '', caption: el.getAttribute('data-lightbox-caption') || '' }));
  let currentIndex = 0;
  const renderLightbox = () => { const item = items[currentIndex]; if (!item || !lightboxImage || !lightboxCaption || !lightboxCounter) return; lightboxImage.src = item.src; lightboxImage.alt = item.alt; lightboxCaption.textContent = item.caption; lightboxCounter.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`; };
  const openLightbox = (index) => { currentIndex = (index + items.length) % items.length; renderLightbox(); lightbox?.classList.add('is-open'); lightbox?.setAttribute('aria-hidden', 'false'); document.body.classList.add('lightbox-open'); };
  const closeLightbox = () => { lightbox?.classList.remove('is-open'); lightbox?.setAttribute('aria-hidden', 'true'); document.body.classList.remove('lightbox-open'); };
  items.forEach((item) => item.el.addEventListener('click', () => openLightbox(item.index)));
  document.querySelector('[data-lightbox-close]')?.addEventListener('click', closeLightbox);
  document.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => openLightbox(currentIndex - 1));
  document.querySelector('[data-lightbox-next]')?.addEventListener('click', () => openLightbox(currentIndex + 1));
  lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeLightbox(); if (lightbox?.classList.contains('is-open') && event.key === 'ArrowLeft') openLightbox(currentIndex - 1); if (lightbox?.classList.contains('is-open') && event.key === 'ArrowRight') openLightbox(currentIndex + 1); });
  let touchStartX = 0;
  lightbox?.addEventListener('touchstart', (event) => { touchStartX = event.touches[0].clientX; }, { passive: true });
  lightbox?.addEventListener('touchend', (event) => { const distance = event.changedTouches[0].clientX - touchStartX; if (Math.abs(distance) > 50) openLightbox(currentIndex + (distance < 0 ? 1 : -1)); }, { passive: true });
</script>

<style is:global>
  @import url('/src/styles/global.css');
</style>
