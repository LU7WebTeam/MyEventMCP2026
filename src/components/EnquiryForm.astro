---
import { QUOTE_CONVERSION_SEND_TO } from '../lib/ads';
import { PHONE_DISPLAY, PHONE_TEL, whatsappHref } from '../lib/contact';

interface Props {
  variant?: 'full' | 'short';
  formName?: string;
  source: string;
  whatsappMessage: string;
  showWhatsapp?: boolean;
}

const {
  variant = 'full',
  formName = 'enquiry',
  source,
  whatsappMessage,
  showWhatsapp = false,
} = Astro.props;

const wa = whatsappHref(whatsappMessage);
---

<div class="enquiry-form-block">
  {showWhatsapp && (
    <div class="enquiry-primary">
      <a class="button button--whatsapp" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp us <span aria-hidden="true">↗︎</span></a>
      <a class="button button--call button--call-dark" href={`tel:${PHONE_TEL}`}>Call {PHONE_DISPLAY}</a>
      <p>WhatsApp is the fastest way to reach the crew. Or send the short form and we will reply within one business day.</p>
    </div>
  )}
  <form class="quote-form" action="/api/quote" method="post" data-quote-form data-form-name={formName}>
    <div class="form-thanks" data-form-thanks hidden>
      <p class="form-thanks__mark" aria-hidden="true">✓</p>
      <h3 tabindex="-1">Thank you.</h3>
      <p>We have received your enquiry and will be in touch shortly. If your event is urgent, call or WhatsApp us.</p>
      <div class="form-thanks__actions">
        <a class="button button--whatsapp" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp us <span aria-hidden="true">↗︎</span></a>
        <a class="button button--call button--call-dark" href={`tel:${PHONE_TEL}`}>Call {PHONE_DISPLAY}</a>
      </div>
    </div>
    <div data-form-fields>
      <div class="form-heading"><p>{variant === 'short' ? 'Tell us the basics.' : 'Start with the basics.'}</p></div>
      <label class="sr-only" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      <input type="hidden" name="source" value={source} />
      <label>Name<input type="text" name="name" placeholder="Your name" autocomplete="name" required /></label>
      <label>Phone number<input type="tel" name="phone" placeholder="01x xxx xxxx" autocomplete="tel" required /></label>
      <label>Event date<input type="date" name="event-date" autocomplete="off" required /></label>
      {variant === 'full' && (
        <>
          <label>Email <span class="field-optional">(optional)</span><input type="email" name="email" placeholder="you@company.com" autocomplete="email" /></label>
          <label>Event type <span class="field-optional">(optional)</span>
            <select name="event-type">
              <option value="">Select one (optional)</option>
              <option value="conference">Conference</option>
              <option value="corporate-gathering">Corporate gathering</option>
              <option value="seminar">Seminar</option>
              <option value="annual-dinner">Annual dinner</option>
              <option value="launch">Launch</option>
              <option value="livestream">Livestream</option>
              <option value="other">Other</option>
            </select>
          </label>
        </>
      )}
      <label>Message <span class="field-optional">(optional)</span><textarea name="message" rows="3" placeholder="Venue, audience size, what you need..."></textarea></label>
      <div class="form-actions form-actions--single">
        <button class="button button--primary" type="submit" data-quote-submit>Send enquiry <span aria-hidden="true">↗︎</span></button>
      </div>
      <p class="form-status" data-quote-form-status role="status" aria-live="polite"></p>
      <p class="form-note">Name, phone and event date are enough. We use these details only to reply to this enquiry.</p>
    </div>
  </form>
</div>

<script is:inline define:vars={{ quoteConversionSendTo: QUOTE_CONVERSION_SEND_TO }}>
  (function () {
    var sendQuoteConversion = function (transactionId) {
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      window.gtag('event', 'conversion', {
        send_to: quoteConversionSendTo,
        value: 100,
        currency: 'MYR',
        transaction_id: transactionId,
      });
    };
    var push = function (eventName, params) {
      window.dataLayer = window.dataLayer || [];
      var payload = { event: eventName };
      if (params) Object.keys(params).forEach(function (key) { payload[key] = params[key]; });
      window.dataLayer.push(payload);
    };
    var submissionId = function () {
      try { return crypto.randomUUID(); } catch (e) { return 'quote-' + Date.now(); }
    };

    document.querySelectorAll('[data-quote-form]').forEach(function (form) {
      if (!form || form.tagName !== 'FORM' || form.dataset.quoteBound === '1') return;
      form.dataset.quoteBound = '1';
      var started = false;
      form.addEventListener('focusin', function () {
        if (started) return;
        started = true;
        push('quote_form_start', { form_name: form.getAttribute('data-form-name') || 'enquiry' });
      });

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        if (form.dataset.sending === '1' || form.dataset.quoteTracked === '1') return;
        var button = form.querySelector('[data-quote-submit]');
        var status = form.querySelector('[data-quote-form-status]');
        var fields = form.querySelector('[data-form-fields]');
        var thanks = form.querySelector('[data-form-thanks]');
        if (!button) return;
        var original = button.innerHTML;
        var transactionId = submissionId();
        form.dataset.sending = '1';
        button.disabled = true;
        button.textContent = 'Sending…';
        if (status) {
          status.textContent = '';
          status.classList.remove('is-error');
        }

        fetch('/api/quote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(form)),
        })
          .then(function (res) { return res.json().catch(function () { return { success: false }; }); })
          .then(function (result) {
            if (result && result.success) {
              form.dataset.quoteTracked = '1';
              form.classList.add('is-sent');
              if (fields) fields.hidden = true;
              if (thanks) thanks.hidden = false;
              if (result.tracked !== false) {
                push('quote_form_submit', {
                  form_name: form.getAttribute('data-form-name') || 'enquiry',
                  value: 100,
                  currency: 'MYR',
                  transaction_id: transactionId,
                });
                // Server accepted the lead. GTM has no thank-you label, so ping Ads from here.
                sendQuoteConversion(transactionId);
              }
              if (thanks) {
                thanks.scrollIntoView({ block: 'center', behavior: 'instant' });
                var heading = thanks.querySelector('h3');
                if (heading) heading.focus({ preventScroll: true });
              }
              return;
            }
            form.dataset.sending = '0';
            button.disabled = false;
            button.innerHTML = original;
            if (status) {
              status.classList.add('is-error');
              status.textContent = (result && result.message) || 'We could not send your enquiry. Please try again, or WhatsApp us.';
            }
            push('quote_form_error', {
              form_name: form.getAttribute('data-form-name') || 'enquiry',
              reason: (result && result.message) || 'unknown',
            });
          })
          .catch(function () {
            form.dataset.sending = '0';
            button.disabled = false;
            button.innerHTML = original;
            if (status) {
              status.classList.add('is-error');
              status.textContent = 'We could not reach our server. Please try again, or WhatsApp us.';
            }
            push('quote_form_error', { form_name: form.getAttribute('data-form-name') || 'enquiry', reason: 'network' });
          });
      });
    });
  })();
</script>
