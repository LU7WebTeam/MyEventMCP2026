---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';

const { kind, item, related } = Astro.props;
const isEvents = kind === 'events';
const label = isEvents ? 'Event type' : 'Location';
const title = isEvents ? `${item.name} event production.` : `Event production in ${item.name}.`;
const description = `${item.shortDescription} MyEventMCP provides professional multi-camera production across Malaysia.`;
const list = isEvents ? item.scenarios : item.areas;
const listLabel = isEvents ? 'Typical fit' : 'Areas we cover';
const packages = [
  { name: 'Silver MCP', eyebrow: 'Essential coverage', price: 'RM1,800', setup: '1 static camera / 2 crews', description: 'A focused, single-angle setup for events with one clear focal point.', tone: 'silver', href: '/silver-mcp-package/' },
  { name: 'Gold MCP', eyebrow: 'Enhanced coverage', price: 'RM2,800', setup: '2 static cameras / 3 crews', description: 'A more dynamic view that keeps the stage and audience in the story.', tone: 'red', href: '/gold-mcp-package/' },
  { name: 'Diamond MCP', eyebrow: 'Premium coverage', price: 'RM5,500', setup: '3 static cameras / 4 crews', description: 'Complete multi-angle coverage for larger, higher-stakes productions.', tone: 'navy', href: '/diamond-mcp-package/' },
  { name: 'PTZ RoboCam', eyebrow: 'Remote-controlled coverage', price: 'RM4,500', setup: '3 PTZ cameras / 3 crews', description: 'Flexible pan, tilt and zoom coverage from a compact production footprint.', tone: 'gold', href: '/ptz-robocam-setup/' },
];
const customPackage = { name: 'Customised Solution', eyebrow: 'Need something specific?', tagline: 'Mix and match. Make it yours.', href: '/customised-solution/' };
const pageUrl = `https://myeventmcp.com/${kind}/${item.slug}/`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': isEvents ? 'Service' : 'LocalBusiness',
      name: `${item.name} ${isEvents ? 'event production' : 'event coverage'}`,
      description,
      url: pageUrl,
      provider: { '@type': 'Organization', name: 'MyEventMCP', url: 'https://myeventmcp.com/' },
      areaServed: isEvents ? 'Malaysia' : item.name,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://myeventmcp.com/' },
        { '@type': 'ListItem', position: 2, name: isEvents ? 'Event types' : 'Locations', item: `https://myeventmcp.com/${kind}/` },
        { '@type': 'ListItem', position: 3, name: item.name, item: pageUrl },
      ],
    },
    ...(item.faqs ? [{
      '@type': 'FAQPage',
      mainEntity: item.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq[0],
        acceptedAnswer: { '@type': 'Answer', text: faq[1] },
      })),
    }] : []),
  ],
};
---

<BaseLayout title={`${item.name} | MyEventMCP`} description={description} image="/legacy-images/2025/01/DSC02241-scaled.jpg">
  <div class="seo-page">
    <header class="site-header" data-header><div class="header-inner"><a class="brand" href="/" aria-label="MyEventMCP home"><img src="/logo-color.webp" alt="MyEventMCP" /></a><nav class="desktop-nav" aria-label="Primary navigation"><a href="/#about">About</a><a href="/#packages">Packages</a><a href="/events/">Events</a><a href="/locations/">Locations</a></nav><div class="header-right"><a class="button button--small header-cta" href="/#quote">Get a quote <span aria-hidden="true">↗</span></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle><span></span><span></span><span class="sr-only">Open navigation</span></button></div></div></header>
    <div class="mobile-menu" id="mobile-menu" data-mobile-menu><div class="mobile-menu__top"><span class="mono-label">{label}</span><button class="menu-close" type="button" data-menu-close aria-label="Close navigation">×</button></div><nav aria-label="Mobile navigation"><a href="/#about">About</a><a href="/#packages">Packages</a><a href="/events/">Events</a><a href="/locations/">Locations</a><a class="button" href="/#quote">Get a quote <span aria-hidden="true">↗</span></a></nav></div>
    <main>
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      <section class="seo-hero section-dark seo-hero--image"><div class="seo-hero__image"><img src="/legacy-images/2025/01/DSC02241-scaled.jpg" alt={isEvents ? 'Event production team monitoring a live multi-camera feed.' : `Event production team monitoring a live multi-camera feed in ${item.name}.`} /></div><div class="seo-hero__wash"></div><div class="container"><a class="back-link back-link--light" href={`/${kind}/`}>← All {isEvents ? 'event types' : 'locations'}</a><p class="eyebrow eyebrow--light">MyEventMCP / {label}</p><h1>{title}</h1><p class="seo-hero__lead">{item.shortDescription}</p><a class="button button--primary" href="/#quote">Plan your event <span aria-hidden="true">↗</span></a></div></section>
      <section class="section seo-intro"><div class="container seo-content__grid"><div><p class="eyebrow">Why MyEventMCP</p><h2>Multi-camera production,<br /><em>for {item.name}.</em></h2></div><div><p class="seo-content__lead">{item.intro}</p><div class="seo-chips"><span class="mono-label">{listLabel}</span><div>{list.map((entry) => <span>{entry}</span>)}</div></div><div class="seo-benefits__row">{item.benefits.map((benefit, index) => <div><strong>0{index + 1}</strong><h3>{benefit[0]}</h3><p>{benefit[1]}</p></div>)}</div><a class="text-link" href="#packages">See which setup fits your event <span aria-hidden="true">↓</span></a></div></div></section>
      <section class="section section-dark section-packages" id="packages" aria-labelledby="packages-title"><div class="container"><div class="section-heading section-heading--split section-heading--light"><div><p class="eyebrow eyebrow--light">Find your setup</p><h2 id="packages-title">Coverage that fits<br /><em>the moment.</em></h2></div><p>Start with a proven package or build a customised solution around your venue, audience and production goals.</p></div><div class="package-grid">{packages.map((pkg) => { const isRecommended = isEvents && item.recommended && item.recommended.slug === pkg.href.replace(/^\//, '').replace(/\/$/, ''); return <article class={`package-card package-card--${pkg.tone}${isRecommended ? ' package-card--recommended' : ''}`}>{isRecommended && <span class="package-card__badge">Recommended</span>}<div class="package-card__top"><p class="eyebrow">{pkg.eyebrow}</p><span class="package-card__dot"></span></div><h3>{pkg.name}</h3><p class="package-card__description">{pkg.description}</p>{isRecommended && <span class="package-card__reason">{item.recommended.reason}</span>}<span class="package-card__setup">{pkg.setup}</span><div class="package-card__bottom"><div><span class="mono-label">From</span><strong>{pkg.price}<small>/day</small></strong></div><a class="circle-arrow" href={pkg.href} aria-label={`Get a quote for ${pkg.name}`}>↗</a></div></article>; })}</div><div class="custom-bar"><div><span class="eyebrow eyebrow--light">{customPackage.eyebrow}</span><h3>{customPackage.tagline}</h3></div><a class="button button--gold" href={customPackage.href}>Customised solution <span aria-hidden="true">↗</span></a></div><div class="seo-included__bar"><span class="mono-label">Every package includes</span><div>{item.included.map((entry) => <span>{entry}</span>)}</div></div><a class="button button--primary" href="/#quote">Discuss your event <span aria-hidden="true">↗</span></a></div></section>
      <section class="section seo-workflow"><div class="container"><div class="seo-section-heading"><div><p class="eyebrow">How we work</p><h2>From brief<br /><em>to final cut.</em></h2></div><p>A simple, structured process — from your first call to the final recording.</p></div><div class="seo-workflow__grid"><div class="seo-workflow__steps"><article><strong>01</strong><div><h3>Brief the room</h3><p>Tell us your venue, programme, audience and date.</p></div></article><article><strong>02</strong><div><h3>Shape the setup</h3><p>We recommend the right package, angles and crew.</p></div></article><article><strong>03</strong><div><h3>Keep it moving</h3><p>Our operators manage production from setup to recording.</p></div></article></div><div class="seo-workflow__gallery"><img src="/legacy-images/2025/01/DSC02235-scaled.jpg" alt={isEvents ? 'Production crew setting up cameras for a live event.' : `Production crew setting up cameras for an event in ${item.name}.`} /><img src="/legacy-images/2025/01/DSC00768-scaled.jpg" alt={isEvents ? 'Camera operator monitoring a live event feed.' : `Camera operator monitoring a live event feed in ${item.name}.`} /></div></div></div></section>
      <section class="section seo-faq"><div class="container faq-layout"><div><p class="eyebrow">FAQ</p><h2>{item.name}<br /><em>{isEvents ? 'production FAQs.' : 'event coverage.'}</em></h2><p class="faq-intro">A few practical answers before we get into the details of your event.</p><a class="text-link" href="https://wa.me/601133078724">Still have questions? WhatsApp us <span aria-hidden="true">↗</span></a></div><div class="faq-list">{item.faqs.map((faq) => <details><summary>{faq[0]}<span>+</span></summary><p>{faq[1]}</p></details>)}</div></div></section>
      <section class="section seo-related"><div class="container"><p class="eyebrow">Keep exploring</p><h2>More {isEvents ? 'event types' : 'locations'}<br /><em>to explore.</em></h2><div class="seo-related__grid">{related.map((entry) => <a href={`/${kind}/${entry.slug}/`}><span class="mono-label">{label}</span><h3>{entry.name}</h3><span class="circle-arrow">↗</span></a>)}</div></div></section>
      <section class="seo-cta section-dark"><div class="container seo-cta__inner"><div><p class="eyebrow eyebrow--light">Ready when you are</p><h2>{isEvents ? <>Let's cover your<br /><em>{item.name}.</em></> : <>Planning an event<br /><em>in {item.name}?</em></>}</h2></div><div><p>Share your event details and our team will recommend a practical production setup.</p><a class="button button--primary" href="/#quote">Request a quote <span aria-hidden="true">↗</span></a></div></div></section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<script>
  const header = document.querySelector('[data-header]'); const menu = document.querySelector('[data-mobile-menu]'); const toggle = document.querySelector('[data-menu-toggle]'); const close = document.querySelector('[data-menu-close]');
  const setMenu = (open) => { menu?.classList.toggle('is-open', open); toggle?.setAttribute('aria-expanded', String(open)); document.body.classList.toggle('menu-open', open); };
  toggle?.addEventListener('click', () => setMenu(true)); close?.addEventListener('click', () => setMenu(false)); menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false))); window.addEventListener('scroll', () => header?.classList.toggle('is-scrolled', window.scrollY > 20), { passive: true });
</script>
