---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryForm from './EnquiryForm.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { whatsappHref } from '../lib/contact';

const { kind, item, related } = Astro.props;
const isEvents = kind === 'events';
const label = isEvents ? 'Event type' : 'Location';
const title = item.headline || (isEvents ? `${item.name} event production.` : `Event production in ${item.name}.`);
const description = `${item.shortDescription} MyEventMCP provides professional multi-camera production across Malaysia.`;
const list = isEvents ? item.scenarios : item.areas;
const listLabel = isEvents ? 'Typical fit' : 'Areas we cover';
const isAdLanding = item.slug === 'broadcast-video-production' || item.slug === 'kuala-lumpur';
const whatsappMessage = item.whatsappMessage || (isEvents
  ? `Hi, I'm interested in ${item.name.toLowerCase()} for my event.`
  : `Hi, I'm interested in event production in ${item.name}.`);
const wa = whatsappHref(whatsappMessage);
const quoteHref = isAdLanding ? '#enquiry' : '/#quote';
const packages = [
  { name: 'Silver MCP', eyebrow: 'Essential coverage', price: 'RM1,800', setup: '1 static camera / 2 crews', description: 'A focused, single-angle setup for events with one clear focal point.', tone: 'silver', href: '/silver-mcp-package/' },
  { name: 'Gold MCP', eyebrow: 'Enhanced coverage', price: 'RM2,800', setup: '2 static cameras / 3 crews', description: 'A more dynamic view that keeps the stage and audience in the story.', tone: 'red', href: '/gold-mcp-package/' },
  { name: 'Diamond MCP', eyebrow: 'Premium coverage', price: 'RM5,500', setup: '3 static cameras / 4 crews', description: 'Complete multi-angle coverage for larger, higher-stakes productions.', tone: 'navy', href: '/diamond-mcp-package/' },
  { name: 'PTZ RoboCam', eyebrow: 'Remote-controlled coverage', price: 'RM4,500', setup: '3 PTZ cameras / 3 crews', description: 'Flexible pan, tilt and zoom coverage from a compact production footprint.', tone: 'gold', href: '/ptz-robocam-setup/' },
];
const pageUrl = `https://myeventmcp.com/${kind}/${item.slug}/`;
const pageTitle = item.headline ? `${item.headline} | MyEventMCP` : `${item.name} | MyEventMCP`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': isEvents ? 'Service' : 'LocalBusiness',
      name: `${item.name} ${isEvents ? 'event production' : 'event coverage'}`,
      description,
      url: pageUrl,
      provider: { '@type': 'Organization', name: 'MyEventMCP', url: 'https://myeventmcp.com/' },
      areaServed: isEvents ? 'Malaysia' : item.name,
      telephone: '+60386053563',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://myeventmcp.com/' },
        { '@type': 'ListItem', position: 2, name: isEvents ? 'Event types' : 'Locations', item: `https://myeventmcp.com/${kind}/` },
        { '@type': 'ListItem', position: 3, name: item.name, item: pageUrl },
      ],
    },
    ...(item.faqs ? [{
      '@type': 'FAQPage',
      mainEntity: item.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq[0],
        acceptedAnswer: { '@type': 'Answer', text: faq[1] },
      })),
    }] : []),
  ],
};
---

<BaseLayout title={pageTitle} description={description} image="/opt/hero-main-1100.webp" whatsappMessage={whatsappMessage} preloadImage="/opt/hero-main-720.webp" preloadSrcset="/opt/hero-main-720.webp 720w, /opt/hero-main-1100.webp 1100w" preloadSizes="100vw">
  <div class="seo-page">
    <SiteHeader slim={isAdLanding} nav="marketing" whatsappMessage={whatsappMessage} quoteHref={quoteHref} menuLabel={label} />
    <main>
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      <section class="seo-hero section-dark seo-hero--image">
        <div class="seo-hero__image"><img src="/opt/hero-main-720.webp" srcset="/opt/hero-main-720.webp 720w, /opt/hero-main-1100.webp 1100w" sizes="100vw" width="1100" height="619" alt={isEvents ? 'Event production team monitoring a live multi-camera feed.' : `Event production team monitoring a live multi-camera feed in ${item.name}.`} fetchpriority="high" decoding="async" /></div>
        <div class="seo-hero__wash"></div>
        <div class="container">
          {!isAdLanding && <a class="back-link back-link--light" href={`/${kind}/`}>← All {isEvents ? 'event types' : 'locations'}</a>}
          <p class="eyebrow eyebrow--light">MyEventMCP / {label}</p>
          <h1>{title}</h1>
          <p class="seo-hero__lead">{item.shortDescription}</p>
          <div class="seo-hero__actions">
            <a class="button button--whatsapp" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp us <span aria-hidden="true">↗︎</span></a>
            <a class="button button--call" href="tel:+60386053563">Call 03-8605 3563</a>
            {!isAdLanding && <a class="text-link text-link--light" href={quoteHref}>Plan your event <span aria-hidden="true">↗︎</span></a>}
          </div>
        </div>
      </section>
      <section class="section seo-intro"><div class="container seo-content__grid"><div><p class="eyebrow">Why MyEventMCP</p><h2>Multi-camera production,<br /><em>for {item.name}.</em></h2></div><div><p class="seo-content__lead">{item.intro}</p><div class="seo-chips"><span class="mono-label">{listLabel}</span><div>{list.map((entry) => <span>{entry}</span>)}</div></div><div class="seo-benefits__row">{item.benefits.map((benefit, index) => <div><strong>0{index + 1}</strong><h3>{benefit[0]}</h3><p>{benefit[1]}</p></div>)}</div><a class="text-link" href="#packages">See which setup fits your event <span aria-hidden="true">↓</span></a></div></div></section>
      <section class="section section-dark section-packages" id="packages" aria-labelledby="packages-title"><div class="container"><div class="section-heading section-heading--split section-heading--light"><div><p class="eyebrow eyebrow--light">Find your setup</p><h2 id="packages-title">Coverage that fits<br /><em>the moment.</em></h2></div><p>Start with a proven package or build a customised solution around your venue, audience and production goals.</p></div><div class="package-grid">{packages.map((pkg) => { const isRecommended = isEvents && item.recommended && item.recommended.slug === pkg.href.replace(/^\//, '').replace(/\/$/, ''); const cardHref = isAdLanding ? '#enquiry' : pkg.href; return <article class={`package-card package-card--${pkg.tone}${isRecommended ? ' package-card--recommended' : ''}`}>{isRecommended && <span class="package-card__badge">Recommended</span>}<div class="package-card__top"><p class="eyebrow">{pkg.eyebrow}</p><span class="package-card__dot"></span></div><h3>{pkg.name}</h3><p class="package-card__description">{pkg.description}</p>{isRecommended && <span class="package-card__reason">{item.recommended.reason}</span>}<span class="package-card__setup">{pkg.setup}</span><div class="package-card__bottom"><div><span class="mono-label">From</span><strong>{pkg.price}<small>/day</small></strong></div><a class="circle-arrow" href={cardHref} aria-label={isAdLanding ? `Enquire about ${pkg.name}` : `Get a quote for ${pkg.name}`}>↗︎</a></div></article>; })}</div><div class="custom-bar"><div><span class="eyebrow eyebrow--light">Need something specific?</span><h3>Mix and match. Make it yours.</h3></div><a class="button button--gold" href={isAdLanding ? '#enquiry' : '/customised-solution/'}>{isAdLanding ? 'Tell us about your event' : 'Customised solution'} <span aria-hidden="true">↗︎</span></a></div><div class="seo-included__bar"><span class="mono-label">Every package includes</span><div>{item.included.map((entry) => <span>{entry}</span>)}</div></div><a class="button button--primary" href={quoteHref}>{isAdLanding ? 'Send an enquiry' : 'Discuss your event'} <span aria-hidden="true">↗︎</span></a></div></section>
      <section class="section seo-workflow"><div class="container"><div class="seo-section-heading"><div><p class="eyebrow">How we work</p><h2>From brief<br /><em>to final cut.</em></h2></div><p>A simple, structured process — from your first call to the final recording.</p></div><div class="seo-workflow__grid"><div class="seo-workflow__steps"><article><strong>01</strong><div><h3>Brief the room</h3><p>Tell us your venue, programme, audience and date.</p></div></article><article><strong>02</strong><div><h3>Shape the setup</h3><p>We recommend the right package, angles and crew.</p></div></article><article><strong>03</strong><div><h3>Keep it moving</h3><p>Our operators manage production from setup to recording.</p></div></article></div><div class="seo-workflow__gallery"><img src="/opt/hero-bg-800.webp" width="800" height="450" loading="lazy" decoding="async" alt={isEvents ? 'Production crew setting up cameras for a live event.' : `Production crew setting up cameras for an event in ${item.name}.`} /><img src="/opt/quote-bg-1000.webp" width="1000" height="667" loading="lazy" decoding="async" alt={isEvents ? 'Camera operator monitoring a live event feed.' : `Camera operator monitoring a live event feed in ${item.name}.`} /></div></div></div></section>
      <section class="section seo-faq"><div class="container faq-layout"><div><p class="eyebrow">FAQ</p><h2>{item.name}<br /><em>{isEvents ? 'production FAQs.' : 'event coverage.'}</em></h2><p class="faq-intro">A few practical answers before we get into the details of your event.</p><a class="text-link" href={wa} target="_blank" rel="noopener noreferrer">Still have questions? WhatsApp us <span aria-hidden="true">↗︎</span></a></div><div class="faq-list">{item.faqs.map((faq) => <details><summary>{faq[0]}<span>+</span></summary><p>{faq[1]}</p></details>)}</div></div></section>
      {!isAdLanding && <section class="section seo-related"><div class="container"><p class="eyebrow">Keep exploring</p><h2>More {isEvents ? 'event types' : 'locations'}<br /><em>to explore.</em></h2><div class="seo-related__grid">{related.map((entry) => <a href={`/${kind}/${entry.slug}/`}><span class="mono-label">{label}</span><h3>{entry.name}</h3><span class="circle-arrow">↗︎</span></a>)}</div></div></section>}
      {isAdLanding ? (
        <section class="enquiry-section" id="enquiry" aria-labelledby="enquiry-title">
          <div class="container enquiry-layout">
            <div class="enquiry-copy">
              <p class="eyebrow">Ready when you are</p>
              <h2 id="enquiry-title">{isEvents ? <>Let's cover your<br /><em>{item.name}.</em></> : <>Planning an event<br /><em>in {item.name}?</em></>}</h2>
              <p>Share your name, phone and event date. We will recommend a practical setup for the room.</p>
            </div>
            <EnquiryForm variant="short" formName={`${kind}-${item.slug}`} source={`/${kind}/${item.slug}/`} whatsappMessage={whatsappMessage} showWhatsapp />
          </div>
        </section>
      ) : (
        <section class="seo-cta section-dark"><div class="container seo-cta__inner"><div><p class="eyebrow eyebrow--light">Ready when you are</p><h2>{isEvents ? <>Let's cover your<br /><em>{item.name}.</em></> : <>Planning an event<br /><em>in {item.name}?</em></>}</h2></div><div><p>Share your event details and our team will recommend a practical production setup.</p><a class="button button--whatsapp" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp us <span aria-hidden="true">↗︎</span></a><a class="button button--call" href="tel:+60386053563">Call 03-8605 3563</a></div></div></section>
      )}
    </main>
    <SiteFooter minimal={isAdLanding} whatsappMessage={whatsappMessage} />
  </div>
</BaseLayout>
