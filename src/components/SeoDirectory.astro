---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { DEFAULT_WHATSAPP_MESSAGE } from '../lib/contact';

const { kind, items } = Astro.props;
const isEvents = kind === 'events';
const label = isEvents ? 'Event types' : 'Locations';
const title = isEvents ? 'Event production for every occasion.' : 'Event production across Malaysia.';
const description = isEvents
  ? 'Explore multi-camera production services for conferences, launches, awards, broadcasts and more.'
  : 'Explore professional multi-camera event production services in Kuala Lumpur and across Malaysia.';
const whatsappMessage = isEvents
  ? "Hi, I'm interested in multi-camera production for my event."
  : "Hi, I'm interested in event production in Malaysia.";
---

<BaseLayout title={`${label} | MyEventMCP`} description={description} image="/opt/hero-main-1100.webp" whatsappMessage={whatsappMessage || DEFAULT_WHATSAPP_MESSAGE}>
  <div class="seo-page">
    <SiteHeader nav="marketing" whatsappMessage={whatsappMessage} menuLabel="EXPLORE" />
    <main>
      <section class="seo-hero section-dark"><div class="container"><p class="eyebrow eyebrow--light">MyEventMCP / {label}</p><h1>{title}</h1><p class="seo-hero__lead">{description}</p><div class="seo-hero__actions"><a class="button button--whatsapp" href={`https://wa.me/601133078724?text=${encodeURIComponent(whatsappMessage)}`} target="_blank" rel="noopener noreferrer">WhatsApp us <span aria-hidden="true">↗︎</span></a><a class="button button--call" href="tel:+60386053563">Call 03-8605 3563</a></div></div></section>
      <section class="section seo-directory"><div class="container"><div class="seo-directory__heading"><p class="eyebrow">Find your fit</p><h2>{isEvents ? 'Built for the way your event moves.' : 'Coverage where your event happens.'}</h2></div><div class="seo-directory__grid"><a class="seo-directory__card seo-directory__card--all" href={`/${kind === 'events' ? 'events' : 'locations'}/`}><span class="mono-label">Browse</span><h3>All {label.toLowerCase()}</h3><span class="circle-arrow">↗︎</span></a>{items.map((item) => <a class="seo-directory__card" href={`/${kind}/${item.slug}/`}><span class="mono-label">{isEvents ? 'Event type' : 'Location'}</span><h3>{item.name}</h3><p>{item.shortDescription}</p><span class="circle-arrow">↗︎</span></a>)}</div></div></section>
    </main>
    <SiteFooter whatsappMessage={whatsappMessage} />
  </div>
</BaseLayout>
